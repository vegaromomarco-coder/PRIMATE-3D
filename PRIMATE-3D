<script>
  (function initProductLogic() {
    // State
    const state = {
      product: 'Dragón Articulado de Cristal',
      basePrice: 380,
      materialExtra: 0,
      materialName: 'PLA Silk Dual Tornasol',
      colorName: 'Seda Púrpura / Cian',
      sizeName: 'Mediano',
      sizeLength: '20 cm',
      quantity: 1,
      isFav: false
    };

    // Elements
    const displayedPrice = document.getElementById('displayedPrice');
    const stickySummary = document.getElementById('stickySummary');
    const stickyFinalPrice = document.getElementById('stickyFinalPrice');
    const btnWhatsAppOrder = document.getElementById('btnWhatsAppOrder');
    const btnAddToList = document.getElementById('btnAddToList');
    const actionToast = document.getElementById('actionToast');
    const toastMsg = document.getElementById('toastMsg');
    const qtyVal = document.getElementById('qtyVal');
    const favIcon = document.getElementById('favIcon');
    const selectedMatLabel = document.getElementById('selectedMatLabel');
    const selectedColorName = document.getElementById('selectedColorName');

    function updateSummary() {
      const unitTotal = state.basePrice + state.materialExtra;
      const grandTotal = unitTotal * state.quantity;

      displayedPrice.innerHTML = `$${grandTotal} <span class="text-title-md font-normal text-on-surface-variant">MXN</span>`;
      stickyFinalPrice.textContent = `$${grandTotal} MXN`;
      stickySummary.textContent = `${state.sizeName} (${state.sizeLength}) • ${state.colorName}`;

      // Prepare encoded WhatsApp payload URL
      const message = `Hola PRIMATE-3D, quiero pedir el ${state.product}:\n- Escala: ${state.sizeName} (${state.sizeLength})\n- Material: ${state.materialName}\n- Tonalidad: ${state.colorName}\n- Cantidad: ${state.quantity}\n- Total estimado: $${grandTotal} MXN\n¿Me pueden confirmar tiempos de taller y datos de envío?`;
      btnWhatsAppOrder.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
    }

    function showToast(text) {
      toastMsg.textContent = text;
      actionToast.classList.remove('opacity-0');
      actionToast.classList.add('opacity-100');
      setTimeout(() => {
        actionToast.classList.remove('opacity-100');
        actionToast.classList.add('opacity-0');
      }, 2400);
    }

    // Material Selector
    document.querySelectorAll('.mat-option').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.mat-option').forEach(el => {
          el.classList.remove('bg-surface-container-high', 'shadow-md');
          el.classList.add('bg-surface-container');
        });
        btn.classList.add('bg-surface-container-high', 'shadow-md');

        const mat = btn.getAttribute('data-mat');
        state.materialName = btn.getAttribute('data-label');
        selectedMatLabel.textContent = state.materialName;

        if (mat === 'resina') state.materialExtra = 95;
        else if (mat === 'glow') state.materialExtra = 60;
        else state.materialExtra = 0;

        updateSummary();
      });
    });

    // Color Selector
    document.querySelectorAll('.color-swatch-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.color-swatch-btn').forEach(el => {
          el.classList.remove('bg-surface-container-highest', 'shadow-inner');
          el.classList.add('bg-surface-container');
        });
        btn.classList.add('bg-surface-container-highest', 'shadow-inner');
        state.colorName = btn.getAttribute('data-color');
        selectedColorName.textContent = state.colorName;
        updateSummary();
      });
    });

    // Size Selector
    document.querySelectorAll('.size-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.size-btn').forEach(el => {
          el.classList.remove('bg-surface-container-high', 'shadow-md');
          el.classList.add('bg-surface-container');
          const title = el.querySelector('p');
          if (title) {
            title.classList.remove('text-primary');
            title.classList.add('text-on-surface');
          }
        });
        btn.classList.add('bg-surface-container-high', 'shadow-md');
        const p = btn.querySelector('p');
        if (p) {
          p.classList.add('text-primary');
          p.classList.remove('text-on-surface');
        }

        state.sizeName = btn.getAttribute('data-size');
        state.sizeLength = btn.getAttribute('data-length');
        state.basePrice = parseInt(btn.getAttribute('data-price'), 10);
        updateSummary();
      });
    });

    // Quantity Handlers
    document.getElementById('qtyPlus').addEventListener('click', () => {
      state.quantity += 1;
      qtyVal.textContent = state.quantity;
      updateSummary();
    });

    document.getElementById('qtyMinus').addEventListener('click', () => {
      if (state.quantity > 1) {
        state.quantity -= 1;
        qtyVal.textContent = state.quantity;
        updateSummary();
      }
    });

    // Favorite Button
    document.getElementById('btnFav').addEventListener('click', () => {
      state.isFav = !state.isFav;
      favIcon.textContent = state.isFav ? 'favorite' : 'favorite_border';
      favIcon.style.color = state.isFav ? '#ec6a06' : '';
      if (state.isFav) {
        favIcon.style.fontVariationSettings = "'FILL' 1";
        showToast('Guardado en tus favoritos de impresión');
      } else {
        favIcon.style.fontVariationSettings = "'FILL' 0";
      }
    });

    // Share Button
    document.getElementById('btnShare').addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({
          title: 'Dragón Articulado de Cristal - PRIMATE-3D',
          text: 'Mira esta pieza impresa en 3D con tecnología print-in-place y seda iridiscente.',
          url: window.location.href
        }).catch(() => {});
      } else {
        showToast('Enlace copiado al portapapeles');
      }
    });

    // Add to List Action
    btnAddToList.addEventListener('click', () => {
      showToast(`¡${state.quantity}x ${state.product} añadido a tu lista!`);
    });

    // Initial sync
    updateSummary();
  })();
</script></main><aside class="fixed bottom-6 right-4 z-40"><a aria-label="WhatsApp Cotizaciones" class="flex items-center gap-space-sm h-14 pl-4 pr-5 rounded-full bg-gradient-to-r from-emerald-500 to-teal-400 text-surface-container-lowest font-label-md text-label-md shadow-[0_4px_24px_rgba(16,185,129,0.45)] hover:scale-105 active:scale-95 transition-transform duration-200" href="https://wa.me/" target="_blank"><span class="material-symbols-outlined text-[24px]">chat</span><span class="tracking-wide">Pedir o Cotizar</span></a></aside></body></html>
